# Default versions for all images.
# This is the only place to change them; the GitHub Actions workflow and
# docker/images/build-n8n-robotframework.sh read them from here, and both
# allow overriding each one per build.

# Node.js 24, not 26 (which upstream n8n uses): @confluentinc/kafka-javascript,
# a native n8n dependency, has no prebuilt binary for Node.js 26 and does not
# compile against the old librdkafka in Debian Bookworm, so the n8n image fails
# to build. Node.js 24 has prebuilt binaries, is an official upstream n8n base
# version, and meets n8n's requirement of Node.js >= 24.
# Move to 26 once kafka-javascript publishes "node-v147" binaries:
# https://github.com/confluentinc/confluent-kafka-javascript/releases
NODE_VERSION=24.22.2
N8N_VERSION=2.48.6

ROBOTFRAMEWORK_VERSION=7.5.1
RF_BROWSER_VERSION=21.0.0
# Must match the version required by robotframework-browser
RF_ASSERTION_ENGINE_VERSION=5.0.1
RF_JSONLIBRARY_VERSION=0.5
